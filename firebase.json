{
  "hosting": [
    {
      "target": "cfb",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/schedule.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=900"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        }
      ],
      "cleanUrls": true
    }
  ]
}
